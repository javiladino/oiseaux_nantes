[Unit]
Description=Airflow scheduler (LocalExecutor)
After=network-online.target postgresql.service airflow-api-server.service
Wants=network-online.target
Requires=postgresql.service

[Service]
User=airflow
Group=airflow
EnvironmentFile=/etc/airflow/airflow.env
ExecStart=/opt/airflow-venv/bin/airflow scheduler
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
